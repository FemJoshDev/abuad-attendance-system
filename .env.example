DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public"
NEXTAUTH_SECRET="generate-a-long-random-production-secret"
NEXTAUTH_URL="https://attendance.example.edu"

# Profile photos. Use local only for development; production requires an S3-compatible bucket.
STORAGE_PROVIDER="local"
STORAGE_BUCKET=""
STORAGE_REGION=""
STORAGE_ENDPOINT=""
STORAGE_FORCE_PATH_STYLE="false"
STORAGE_PUBLIC_URL=""
STORAGE_ACCESS_KEY_ID=""
STORAGE_SECRET_ACCESS_KEY=""

# Optional local-only demo seed credentials. Never use these in production.
DEMO_STUDENT_PASSWORD=
DEMO_LECTURER_PASSWORD=
DEMO_ADMIN_PASSWORD=
